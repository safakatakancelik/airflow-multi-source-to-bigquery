# Copy to .env (./scripts/init-env.sh does this and generates the secrets). NEVER commit .env.
#
# Every credential lives here as an Airflow Connection (AIRFLOW_CONN_<ID>, JSON form). The DAG and
# config only refer to connection ids such as "databricks_default" — no secret is in the code.

# --- Airflow itself ---------------------------------------------------------------------
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Destination: BigQuery ----------------------------------------
# Service account key goes in ./secrets/gcp-sa.json (git-ignored). Roles needed:
# BigQuery Data Editor + BigQuery Job User.
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=ingest_demo
BQ_LOCATION=US
AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT='{"conn_type":"google_cloud_platform","extra":{"key_path":"/opt/airflow/secrets/gcp-sa.json","project":"your-gcp-project-id","scope":"https://www.googleapis.com/auth/cloud-platform"}}'

# --- Source 1: Databricks (SQL warehouse + personal access token) ----------------------
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_SOURCE_TABLE=catalog.schema.table
AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type":"databricks","host":"dbc-xxxxxxxx-xxxx.cloud.databricks.com","password":"dapiXXXXXXXX"}'

# --- Source 2: public REST API (PokeAPI — no auth) --------------------------------------
AIRFLOW_CONN_PUBLIC_API_POKEAPI='{"conn_type":"http","host":"https://pokeapi.co"}'

# --- Source 3: Supabase Postgres ----------------------------------------------------------
# Use the "Session pooler" host (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
AIRFLOW_CONN_SUPABASE_DEFAULT='{"conn_type":"postgres","host":"aws-0-REGION.pooler.supabase.com","port":5432,"login":"postgres.YOUR_PROJECT_REF","password":"XXXX","schema":"postgres","extra":{"sslmode":"require"}}'

# --- Source 4: MongoDB Atlas -----------------------------------------------------------------
MONGO_DATABASE=ingest_demo
AIRFLOW_CONN_MONGO_DEFAULT='{"conn_type":"mongo","host":"cluster0.xxxxx.mongodb.net","login":"USER","password":"XXXX","schema":"ingest_demo","extra":{"srv":true}}'

# --- Source 5: Amazon S3 (an IAM user with read access to the bucket) ----------------------
S3_BUCKET=your-bucket-name
S3_OBJECT_KEY=ingest-demo/skills_demand.csv
AIRFLOW_CONN_AWS_DEFAULT='{"conn_type":"aws","login":"AKIAXXXXXXXX","password":"XXXX","extra":{"region_name":"eu-central-1"}}'

# --- Source 6: CSV served over HTTPS from this repo -------------------------------------------
SAMPLE_CSV_URL=https://raw.githubusercontent.com/YOUR_GITHUB_USER/YOUR_REPO/main/data/city_cost_of_living.csv

# --- Optional demo switch: make this source fail its first attempt, then recover on retry -------
# Set as an Airflow Variable instead of editing code:  AIRFLOW_VAR_DEMO_FAIL_FIRST_ATTEMPT=pokeapi_pokemon
# AIRFLOW_VAR_DEMO_FAIL_FIRST_ATTEMPT=
